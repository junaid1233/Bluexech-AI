# Copy to .env and fill in your keys:
#   copy env.example .env   (Windows)
#
# Restart Vite after changing .env

# Optional: OpenAI chatbot
VITE_OPENAI_API_KEY=sk-your-key-here
VITE_OPENAI_MODEL=gpt-4o-mini

# Contact / meeting emails (server-only — do NOT use VITE_ prefix)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Bluexech AI Contact <onboarding@resend.dev>
EMAIL_TO=you@example.com

# Optional: production contact API URL (GitHub Pages needs a hosted API)
# Leave empty in local `npm run dev` — Vite serves POST /api/contact
# VITE_CONTACT_API_URL=https://your-api.example.com/api/contact

# Optional: standalone API port (`npm run server`)
# CONTACT_API_PORT=8787

# Google Calendar + Meet (server-only)
# 1) Add redirect URI: http://localhost:8788/oauth2/callback
# 2) npm run google:oauth  → saves GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_ORGANIZER_EMAIL=you@gmail.com
